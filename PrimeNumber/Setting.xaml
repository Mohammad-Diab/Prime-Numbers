<Window x:Class="PrimeNumber.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الاعدادات" Height="125" Width="300" ResizeMode="NoResize" FlowDirection="RightToLeft" Loaded="Window_Loaded_1" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label x:Name="Label1" Content="اللغة:" HorizontalAlignment="Left" Margin="10,13,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="Languages" HorizontalAlignment="Left" Margin="80,15,0,0" VerticalAlignment="Top" Width="131" SelectedIndex="0">
            <ComboBoxItem  Content="العربية"/>
            <ComboBoxItem  Content="English"/>
        </ComboBox>
        <Button x:Name="Save_Set" Content="حفظ" HorizontalAlignment="Right" Margin="0,0,90,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Height="25" Click="Save_Setting"/>
        <Button x:Name="Cancel1" Content="الغاء" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="75" Background="{x:Null}" Click="Cancel" Height="25"/>
    </Grid>
</Window>
