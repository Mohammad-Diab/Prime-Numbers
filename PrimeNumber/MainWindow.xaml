<Window x:Class="PrimeNumber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="الأعداد الأولية" Height="250" Width="325" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Loaded="Window_Loaded" Icon="Images/Icon32.png">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="AliceBlue" Offset="0" />
            <GradientStop Color="White" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Label x:Name="Label1" Content="إيجاد الأعداد الأولية التي هي أصغر أو تساوي:" Height="Auto" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="13" FontWeight="Normal" HorizontalAlignment="Left"/>
        <TextBox Height="Auto" Margin="50,39,0,0" Name="TextBox1" VerticalAlignment="Top" Background="{x:Null}" FlowDirection="LeftToRight" FontSize="13" HorizontalAlignment="Left" Width="164" />
        <GroupBox x:Name="GroupBox1" Header="الأعداد الأولية (الطرق والتحسينات)" HorizontalAlignment="Left" Margin="10,63,0,26" Width="198">
            <Grid>
                <Button x:Name="Slowest" Content="الأبطئ" Margin="10,10,0,0" Background="{x:Null}" HorizontalAlignment="Left" Width="80" Height="25" VerticalAlignment="Top" Click="Slowest_Click" />
                <Button Background="{x:Null}" Content="بطيء" HorizontalAlignment="Left" Margin="95,10,0,0" x:Name="Slow" Width="80" Height="25" VerticalAlignment="Top" Click="Slow_Click" />
                <Button Background="{x:Null}" Content="متوسط السرعة" Margin="10,40,0,0" x:Name="Medium" HorizontalAlignment="Left" Width="80" Height="25" VerticalAlignment="Top" Click="Medium_Click" />
                <Button Background="{x:Null}" Content="سريع" HorizontalAlignment="Left" Margin="95,40,0,0" x:Name="Fast" Width="80" Height="25" VerticalAlignment="Top" Click="Fast_Click" />
                <Button Content="*سريع جدا" Margin="10,70,0,0" x:Name="Fastest" Background="{x:Null}" Click="Faster_Click" HorizontalAlignment="Left" Width="80" Height="25" VerticalAlignment="Top" />
                <Button Content="الأسرع" Margin="96,70,0,0" x:Name="New_Way" Background="{x:Null}" Click="The_Fastest_Click" HorizontalAlignment="Left" Width="80" Height="25" VerticalAlignment="Top" />
            </Grid>
        </GroupBox>
        <Button x:Name="Setting" Content="" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="25" Click="Setting_Click" ToolTip="خيارات" Margin="0,3,3,0">
            <Button.Background>
                <ImageBrush ImageSource="Images/Setting.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>
        <Button x:Name="Help" Content="" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="25" Margin="0,33,3,0" ToolTip="شرح البرنامج" Click="Help_Click">
            <Button.Background>
                <ImageBrush Stretch="Uniform" ImageSource="Images/Help.png"/>
            </Button.Background>
        </Button>
        <Button x:Name="about" Margin="0,63,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="32" Height="25" ToolTip="عن" Click="about_Click" >
            <Button.Background>
                <ImageBrush Stretch="Uniform" ImageSource="Images/about.png"/>
            </Button.Background>
        </Button>
        <CheckBox x:Name="View_Numbers" Content="عرض الاعداد" HorizontalAlignment="Left" Margin="65,0,0,6" VerticalAlignment="Bottom" Checked="ViewNumber_Checked" Unchecked="ViewNumber_Unchecked"/>
        <ListView x:Name="NumberList" HorizontalAlignment="Right" Margin="0,45,40,6" Width="110" Background="#7FFFFFFF" Visibility="Collapsed"/>
    </Grid>
</Window>
