<Window x:Class="PrimeNumber.Info"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="عن" Height="285" Width="391" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight" Icon="Images/about.png" Loaded="Window_Loaded_1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image Margin="128,10,128,0" Height="128" VerticalAlignment="Top" Source="Images/Icon.png"/>
        <Label Content="Dr.Mohammad@outlook.com " Margin="84,0,0,44" VerticalAlignment="Bottom" FontSize="14" FontFamily="Segoe Print" Height="35" Foreground="Red" HorizontalAlignment="Left" Width="217"/>
        <Label x:Name="Label1" Content="Primary Numbers Finding Methods" Margin="0,0,65,89" VerticalAlignment="Bottom" FontSize="14" FontFamily="Segoe Print" Height="35" HorizontalAlignment="Right">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <GradientStop Color="#FF00B9FF" Offset="1"/>
                    <GradientStop Color="Lime"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Image HorizontalAlignment="Left" Margin="15,0,0,21" Width="59" Height="77" VerticalAlignment="Bottom" Source="Images/xbill.png" FlowDirection="LeftToRight"/>
